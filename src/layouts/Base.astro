---
import '../styles/global.css';
import Icone from '../components/Icone.astro';
import { getCollection } from 'astro:content';
import { lien } from '../lib/recettes';
import { NOM_SITE } from '../lib/libelles';

interface Props {
  titre?: string;
  description?: string;
  image?: string; // image d'aperçu (partage)
}
const { titre, image, description = 'Toutes les recettes de Claire, salées et sucrées, réunies dans un carnet.' } = Astro.props;
const titreComplet = titre ? `${titre} · ${NOM_SITE}` : NOM_SITE;
const slugs = (await getCollection('recettes')).map((r) => r.id);
const adresse = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      try {
        const t = localStorage.getItem('recettes-claire:taille');
        if (t) document.documentElement.dataset.taille = t;
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <!-- Site familial : on demande aux moteurs de recherche de ne pas l'indexer. -->
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#f7f1e7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1714" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={lien('icones/favicon-48.png')} sizes="48x48" type="image/png" />
    <link rel="icon" href={lien('icones/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={lien('icones/apple-touch-icon.png')} />
    <link rel="manifest" href={lien('manifest.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={NOM_SITE} />
    <meta property="og:title" content={titre ?? NOM_SITE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={adresse.href} />
    <meta property="og:image" content={new URL(image ?? lien('partage.png'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="visuellement-cache" href="#contenu">Aller au contenu</a>
    <header class="site-tete">
      <div class="conteneur">
        <a class="logo" href={lien()}><span>Les 1000 et 1 recettes</span> <span>de <em>Claire</em></span></a>
        <nav class="site-nav" aria-label="Navigation principale">
          <a href={lien('#carnet')} class="lien-carnet"><Icone nom="livre" /><span class="libelle">Le carnet</span></a>
          <button type="button" id="au-hasard" data-slugs={JSON.stringify(slugs)} data-base={lien('recettes/')}>
            <Icone nom="de" /><span class="libelle">Au hasard</span>
          </button>
          <button type="button" data-ouvrir-minuteur aria-haspopup="dialog">
            <Icone nom="horloge" /><span class="libelle">Minuteur</span><span class="minuteur-badge" aria-live="off"></span>
          </button>
          <a href={lien('?favoris=1#carnet')} data-lien-favoris>
            <Icone nom="coeur" /><span class="libelle">Favoris</span><span class="nb-favoris nb-mes-favoris"></span>
          </a>
          <a href={lien('courses/')} id="lien-courses">
            <Icone nom="panier" /><span class="libelle">Courses</span><span class="nb-favoris nb-courses"></span>
          </a>
        </nav>
        <button type="button" class="taille-entete" data-taille-suivante aria-label="Agrandir le texte" title="Taille du texte">
          A<span>A</span>
        </button>
      </div>
    </header>
    <!-- sur téléphone : les mêmes accès, en bas de l'écran, avec des mots -->
    <nav class="barre-bas" aria-label="Navigation">
      <a href={lien()}><Icone nom="livre" /><span>Accueil</span></a>
      <button type="button" data-ouvrir-minuteur aria-haspopup="dialog">
        <Icone nom="horloge" /><span>Minuteur</span><span class="minuteur-badge" aria-live="off"></span>
      </button>
      <a href={lien('?favoris=1#carnet')} data-lien-favoris>
        <Icone nom="coeur" /><span>Favoris</span><span class="nb-favoris nb-mes-favoris"></span>
      </a>
      <a href={lien('courses/')}>
        <Icone nom="panier" /><span>Courses</span><span class="nb-favoris nb-courses"></span>
      </a>
    </nav>
    <main id="contenu">
      <slot />
    </main>
    <footer class="site-pied">
      <div class="conteneur">
        <p class="signature">{NOM_SITE}</p>
        <p>Carnet de famille · Les recettes sont reproduites telles qu’elle les a écrites.</p>
        <nav class="pied-liens" aria-label="Outils">
          <a href={lien('repas/')}>Préparer un repas</a>
          <a href={lien('courses/')}>Ma liste de courses</a>
          <a href={lien('livre/')}>Le carnet en livre</a>
        </nav>
        <div class="taille-texte" role="group" aria-label="Taille du texte">
          <span>Taille du texte</span>
          <button type="button" data-taille="0" aria-label="Taille normale">A</button>
          <button type="button" data-taille="1" aria-label="Texte plus grand">A+</button>
          <button type="button" data-taille="2" aria-label="Texte encore plus grand">A++</button>
        </div>
      </div>
    </footer>
    <div class="toast" role="status" aria-live="polite"></div>
    <script>
      import { lireFavoris } from '../scripts/favoris';
      import { initialiserMinuteurs } from '../scripts/minuteurs';
      import { lireCourses } from '../scripts/perso';

      initialiserMinuteurs();

      // taille du texte (A, A+, A++) : gardée dans le navigateur
      const majTaille = () => {
        const t = document.documentElement.dataset.taille ?? '0';
        document.querySelectorAll<HTMLButtonElement>('[data-taille]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.taille === t)));
      };
      const choisirTaille = (t: string) => {
        if (t === '0') delete document.documentElement.dataset.taille;
        else document.documentElement.dataset.taille = t;
        try {
          localStorage.setItem('recettes-claire:taille', t);
        } catch {
          /* rien */
        }
        majTaille();
      };
      document.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>('[data-taille], [data-taille-suivante]');
        if (!b) return;
        if (b.dataset.taille) choisirTaille(b.dataset.taille);
        else choisirTaille(String((+(document.documentElement.dataset.taille ?? 0) + 1) % 3));
      });
      majTaille();

      const hasard = document.getElementById('au-hasard') as HTMLButtonElement;
      hasard.addEventListener('click', () => {
        const slugs: string[] = JSON.parse(hasard.dataset.slugs!);
        const ici = location.pathname.split('/').filter(Boolean).pop();
        const choix = slugs.filter((s) => s !== ici);
        location.href = `${hasard.dataset.base}${choix[Math.floor(Math.random() * choix.length)]}/`;
      });

      const majFavoris = () => {
        const n = lireFavoris().length;
        document.querySelectorAll('.nb-mes-favoris').forEach((b) => (b.textContent = n ? String(n) : ''));
      };
      majFavoris();
      window.addEventListener('favoris', majFavoris);
      const majCourses = () => {
        const n = lireCourses().recettes.length;
        document.querySelectorAll('.nb-courses').forEach((b) => (b.textContent = n ? String(n) : ''));
      };
      majCourses();
      window.addEventListener('courses', majCourses);

      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sw.js`).catch(() => {});
      }
    </script>
  </body>
</html>

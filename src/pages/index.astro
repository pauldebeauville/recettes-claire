<script>
  import { basculerFavori, lireFavoris } from '../scripts/favoris';
  import { initialiserCarnet } from '../scripts/carnet';
  import { initialiserInspirations } from '../scripts/inspirations';
  import { initialiserFrigo } from '../scripts/frigo';
  import { lireCuisinees } from '../scripts/perso';

  const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
  initialiserInspirations(base);
  initialiserFrigo(base);
  initialiserCarnet();

  // cœurs des fiches
  // « déjà cuisinée » sur les fiches, et la progression dans le carnet
  const majCuites = () => {
    const cuites = lireCuisinees();
    document.querySelectorAll<HTMLElement>('.fiche[data-slug]').forEach((f) => {
      const oui = f.dataset.slug! in cuites;
      f.classList.toggle('cuite', oui);
      const meta = f.querySelector('.fiche-meta');
      const badge = meta?.querySelector('.badge-cuite');
      if (oui && meta && !badge) meta.insertAdjacentHTML('beforeend', '<span class="badge badge-cuite">✓ Cuisinée</span>');
      if (!oui) badge?.remove();
    });
    const nb = Object.keys(cuites).length;
    const total = document.querySelectorAll('#fiches .fiche').length;
    const zone = document.getElementById('progression');
    if (!zone) return;
    zone.hidden = nb === 0;
    zone.innerHTML = `<span>Vous avez cuisiné <strong>${nb}</strong> recette${nb > 1 ? 's' : ''} du carnet sur ${total}</span>
      <span class="progression-barre" aria-hidden="true"><span style="width:${Math.max(2, (nb / total) * 100)}%"></span></span>
      <a href="?cuite=oui#carnet">Voir lesquelles</a>`;
  };
  majCuites();
  window.addEventListener('cuisinees', majCuites);

  const majCoeurs = () => {
    const favoris = new Set(lireFavoris());
    document.querySelectorAll<HTMLButtonElement>('.fav').forEach((b) => {
      b.setAttribute('aria-pressed', String(favoris.has(b.dataset.slug!)));
    });
  };
  majCoeurs();
  window.addEventListener('favoris', majCoeurs);
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.fav');
    if (b) basculerFavori(b.dataset.slug!);
  });
</script>

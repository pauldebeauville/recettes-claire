---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import IconeCategorie from '../components/IconeCategorie.astro';
import '../styles/fiches.css';
import { CATEGORIES } from '../lib/libelles';
import {
  aLAvance,
  decouperTitre,
  estThermomix,
  lien,
  lienRecette,
  lignesIngredients,
  lirePortions,
  nbIngredients,
  normaliser,
  versionsDe,
} from '../lib/recettes';

// le carnet s'affiche par ordre alphabétique, comme l'index d'un livre
const recettes = (await getCollection('recettes')).sort((a, b) => a.data.titre.localeCompare(b.data.titre, 'fr', { sensitivity: 'base' }));

const fiches = recettes.map((r, ordre) => {
  const d = r.data;
  const v = versionsDe(d);
  const p = lirePortions(v[0].portions);
  return {
    r,
    ordre,
    slug: r.id,
    titre: decouperTitre(d.titre),
    categories: d.categories,
    nb: nbIngredients(d),
    thermomix: estThermomix(d),
    avance: aLAvance(d),
    versions: v.length,
    portions:
      p.mode === 'personnes'
        ? `${p.base}${p.max ? `–${p.max}` : ''} ${p.unite === 'personne' ? 'pers.' : `${p.unite}${p.base > 1 ? 's' : ''}`}`
        : null,
    index: {
      t: normaliser(d.titre),
      i: normaliser(v.flatMap(lignesIngredients).join(' ')),
    },
  };
});

// ce dont « Dans mon frigo, j'ai… » a besoin pour présenter une recette
const donneesFrigo = fiches.map((f) => ({
  s: f.slug,
  u: lienRecette(f.r),
  t: f.titre.principal,
  c: f.categories.map((c) => CATEGORIES[c].label).join(' · '),
  k: CATEGORIES[f.categories[0]].couleur,
  n: f.nb,
}));

// mots d'ingrédients les plus courants, proposés pendant la saisie du frigo
const PAS_DES_INGREDIENTS = new Set(
  'pour avec dans sans environ cuillère cuillères soupe café pincée pincées sachet sachets tranche tranches boîte boîtes gousse gousses branche branches feuille feuilles facultatif frais fraîche fraîches fraîs gros grosse grosses petit petits petite petites bien selon goût quelques morceaux morceau râpé râpée haché hachée hachés coupé coupée coupés verre verres litre litres paquet paquets bocal bocaux type moyen moyenne moyennes belle belles entier entiers entière entières liquide épaisse épais surgelé surgelée surgelés poudre zeste zestes bouquet botte bottes mûrs mûres mûre mûr cuits cuites cuite cuit pièces pièce après autre autres bonne barquette barquettes brins boule boules tasse tasses cuillerée'.split(' '),
);
const frequences = new Map<string, number>();
for (const f of fiches)
  for (const l of versionsDe(f.r.data).flatMap(lignesIngredients))
    for (const m of l.toLowerCase().match(/\p{L}[\p{L}’'-]{3,}/gu) ?? []) {
      const mot = m.replace(/^[dl][’']/, '');
      if (mot.length >= 4 && !PAS_DES_INGREDIENTS.has(mot)) frequences.set(mot, (frequences.get(mot) ?? 0) + 1);
    }
const vocabulaire = [...frequences.entries()].filter(([, n]) => n >= 2).sort((a, b) => b[1] - a[1]).slice(0, 300).map(([m]) => m).sort((a, b) => a.localeCompare(b, 'fr'));

const compte = (f: (x: (typeof fiches)[number]) => boolean) => fiches.filter(f).length;
const total = fiches.length;

const NB_INGREDIENTS = [
  ['5', 'Jusqu’à 5'],
  ['8', '6 à 8'],
  ['12', '9 à 12'],
  ['13', 'Plus de 12'],
];
---

<Base>
  <section class="accueil conteneur">
    <p class="kicker">Carnet de famille · {total} recettes</p>
    <h1 class="accueil-titre">
      Les 1000 <span class="de">et</span> 1 recettes <span class="de">de</span> <span class="prenom">Claire<svg viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M3 15c48-9 98-12 150-10 47 2 95 6 144 1" /></svg></span>
    </h1>
    <p class="accueil-intro">Toutes ses recettes, salées et sucrées, réunies dans un seul carnet.</p>
  </section>

  <section id="carnet" class="carnet" aria-label="Le carnet de recettes">
    <div class="barre">
      <div class="conteneur barre-ligne">
        <label class="recherche">
          <Icone nom="recherche" />
          <span class="visuellement-cache">Rechercher une recette ou un ingrédient</span>
          <input
            id="q"
            type="search"
            autocomplete="off"
            enterkeyhint="search"
            placeholder="Recette ou ingrédient…"
          />
        </label>
        <button type="button" class="bouton" id="ouvrir-filtres">
          <Icone nom="filtres" /> Filtres <span class="nb-filtres"></span>
        </button>
      </div>
    </div>

    <div class="conteneur">
      <!-- le sommaire : les chapitres, puis « Dans mon frigo » -->
      <div class="sommaire-accueil" id="sommaire-accueil">
        <ul class="tuiles" aria-label="Les chapitres du carnet">
          {
            Object.entries(CATEGORIES).map(([cle, c]) => (
              <li>
                <button type="button" class="tuile" data-categorie={cle} style={`--teinte:${c.couleur}`}>
                  <span class="tuile-icone">
                    <IconeCategorie categorie={cle} />
                  </span>
                  <span class="tuile-nom">{c.pluriel}</span>
                  <span class="tuile-nb">{compte((f) => f.categories.includes(cle))}</span>
                </button>
              </li>
            ))
          }
          <li class="tuile-toutes">
            <button type="button" class="tuile" data-tout style="--teinte:var(--encre-2)">
              <span class="tuile-icone"><Icone nom="livre" /></span>
              <span class="tuile-nom">Toutes les recettes</span>
              <span class="tuile-nb">{total}</span>
            </button>
          </li>
        </ul>

        <section class="frigo" id="frigo" aria-labelledby="titre-frigo">
          <div class="frigo-tete">
            <h2 id="titre-frigo">Dans mon frigo, j’ai…</h2>
            <p>Tapez ce que vous avez sous la main, le carnet vous propose une recette.</p>
          </div>
          <div class="frigo-saisie">
            <ul class="frigo-puces" aria-label="Vos ingrédients"></ul>
            <input type="text" list="vocabulaire-frigo" placeholder="Ex. : poireaux, crème, lardons" aria-label="Ajouter un ingrédient" enterkeyhint="done" autocomplete="off" />
          </div>
          <div class="frigo-boutons">
            <button type="button" class="bouton bouton-principal frigo-chercher">Trouver une recette</button>
            <button type="button" class="bouton frigo-vider">Vider</button>
          </div>
          <div class="frigo-resultats" aria-live="polite" hidden></div>
        </section>
      </div>

      <!-- un chapitre, toutes les recettes, ou le résultat d'une recherche -->
      <div class="liste" id="liste" hidden>
        <div class="liste-tete">
          <button type="button" class="bouton retour-sommaire" data-effacer><Icone nom="gauche" /> Sommaire</button>
          <h2 class="titre-liste" id="titre-liste">Toutes les recettes</h2>
          <p class="nb-resultats" aria-live="polite"><strong>{total}</strong> recettes</p>
        </div>
        <div class="etat">
          <ul class="actifs" aria-label="Filtres actifs"></ul>
          <button type="button" class="bouton partager-selection" id="partager-selection" hidden><Icone nom="partager" /> Envoyer ces recettes</button>
        </div>

        <ul class="fiches" id="fiches">
          {
            fiches.map((f) => (
              <li
                class="fiche"
                id={`r-${f.slug}`}
                style={`--teinte:${CATEGORIES[f.categories[0]].couleur}`}
                data-slug={f.slug}
                data-cats={f.categories.join('|')}
                data-nb={f.nb}
                data-tmx={f.thermomix ? '1' : ''}
                data-avance={f.avance ? '1' : ''}
                data-ordre={f.ordre}
              >
                <a href={lienRecette(f.r)}>
                  {f.r.data.photo && <img class="fiche-photo" src={lien(`photos/${f.r.data.photo}`)} alt="" loading="lazy" />}
                  <span class="fiche-texte">
                    <h3 class="fiche-titre">
                      {f.titre.principal}
                      {f.titre.precision && <span class="precision"> {f.titre.precision}</span>}
                    </h3>
                    <span class="fiche-meta">
                      <span class="fiche-cat">{f.categories.map((c) => CATEGORIES[c].label).join(' · ')}</span>
                      {f.portions && <span>{f.portions}</span>}
                      <span>{f.nb} ingrédients</span>
                      {f.versions > 1 && <span class="badge">{f.versions} versions</span>}
                      {f.thermomix && <span class="badge">Thermomix</span>}
                    </span>
                  </span>
                  <Icone nom="droite" class="fiche-fleche" />
                </a>
              </li>
            ))
          }
        </ul>

        <div class="vide" id="vide" hidden>
          <p class="vide-titre">Aucune recette ne correspond.</p>
          <p>Essayez un autre mot, ou retirez un filtre.</p>
          <button type="button" class="bouton" data-effacer>Revenir au sommaire</button>
        </div>
      </div>
    </div>
  </section>

  <dialog id="panneau-filtres" class="panneau" aria-labelledby="titre-filtres">
    <form method="dialog" class="panneau-contenu">
      <header class="panneau-tete">
        <h2 id="titre-filtres">Filtres</h2>
        <button class="bouton bouton-icone" value="fermer" aria-label="Fermer"><Icone nom="fermer" /></button>
      </header>
      <div class="panneau-corps">
        <fieldset>
          <legend>Nombre d’ingrédients</legend>
          <div class="puces">
            {
              NB_INGREDIENTS.map(([v, l]) => (
                <button type="button" class="puce" data-groupe="n" data-valeur={v} aria-pressed="false">
                  {l} <span class="nb" />
                </button>
              ))
            }
          </div>
        </fieldset>
        <fieldset>
          <legend>Particularités</legend>
          <div class="puces">
            <button type="button" class="puce" data-groupe="tmx" data-valeur="1" aria-pressed="false">
              <Icone nom="robot" /> Thermomix <span class="nb" />
            </button>
            <button type="button" class="puce" data-groupe="avance" data-valeur="1" aria-pressed="false">
              <Icone nom="calendrier" /> Se prépare à l’avance <span class="nb" />
            </button>
            <button type="button" class="puce" data-groupe="cuite" data-valeur="oui" aria-pressed="false">
              <Icone nom="coche" /> Déjà cuisinées <span class="nb" />
            </button>
            <button type="button" class="puce" data-groupe="cuite" data-valeur="non" aria-pressed="false">
              Pas encore cuisinées <span class="nb" />
            </button>
          </div>
        </fieldset>
      </div>
      <footer class="panneau-pied">
        <button type="button" class="bouton" data-effacer-filtres>Retirer les filtres</button>
        <button class="bouton bouton-principal" value="fermer" id="voir-resultats">Voir les recettes</button>
      </footer>
    </form>
  </dialog>

  <datalist id="vocabulaire-frigo">{vocabulaire.map((m) => <option value={m} />)}</datalist>
  <script type="application/json" id="donnees-frigo" set:html={JSON.stringify(donneesFrigo)} />
  <script type="application/json" id="index-recherche" set:html={JSON.stringify(fiches.map((f) => ({ s: f.slug, ...f.index })))} />
</Base>

<style>
  .accueil {
    padding-top: clamp(40px, 7vw, 88px);
    padding-bottom: 40px;
  }

  .accueil-titre {
    margin-top: 14px;
    font-size: clamp(2.6rem, 7.5vw, 5.4rem);
    font-weight: 560;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .accueil-titre .de {
    font-style: italic;
    font-weight: 400;
    color: var(--encre-2);
  }

  .prenom {
    position: relative;
    display: inline-block;
    font-style: italic;
    color: var(--accent);
  }

  .prenom svg {
    position: absolute;
    left: 2%;
    right: 0;
    bottom: -0.16em;
    width: 98%;
    height: 0.22em;
    stroke: var(--accent);
    stroke-width: 3.5;
    opacity: 0.55;
  }

  .accueil-intro {
    max-width: 38rem;
    margin-top: 26px;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--encre-2);
  }

  /* ---------- le sommaire ---------- */

  .sommaire-accueil {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 24px;
  }

  .tuiles {
    display: grid;
    /* 4 colonnes sur grand écran, 3 sur tablette : « Accompagnements » doit tenir */
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 760px) {
    .tuiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
  }

  .tuile-toutes {
    grid-column: 1 / -1;
  }

  .tuile {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 64px;
    padding: 14px 14px;
    border: 1px solid var(--trait);
    border-radius: var(--rayon);
    background: var(--carte);
    text-align: left;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }

  .tuile:hover {
    border-color: var(--teinte);
    transform: translateY(-1px);
    box-shadow: var(--ombre);
  }

  .tuile-icone {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--teinte) 13%, transparent);
    color: var(--teinte);
  }

  .tuile-icone :global(svg) {
    width: 26px;
    height: 26px;
    stroke-width: 1.5;
  }

  .tuile-nom {
    hyphens: auto;
    overflow-wrap: break-word;
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 560;
    line-height: 1.2;
  }

  .tuile-nb {
    font-size: 0.875rem;
    color: var(--encre-3);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 560px) {
    .accueil {
      padding-top: 24px;
      padding-bottom: 20px;
    }
    .accueil-intro {
      margin-top: 14px;
    }
  }

  @media (max-width: 420px) {
    .tuile {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 10px;
      padding: 12px;
    }
    .tuile-nb {
      display: none;
    }
    .tuile-toutes .tuile {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .tuile-toutes .tuile-nb {
      display: inline;
    }
    .tuile-icone {
      width: 38px;
      height: 38px;
    }
    .tuile-nom {
      font-size: 0.9375rem;
    }
  }

  /* ---------- barre de recherche ---------- */

  .barre {
    position: sticky;
    top: 0;
    z-index: 20;
    padding: 12px 0;
    background: color-mix(in srgb, var(--fond) 92%, transparent);
    backdrop-filter: blur(10px);
    border-block: 1px solid var(--trait);
  }

  .barre-ligne {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .recherche {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .recherche :global(svg) {
    position: absolute;
    left: 14px;
    top: 50%;
    width: 19px;
    height: 19px;
    transform: translateY(-50%);
    color: var(--encre-3);
    pointer-events: none;
  }

  .recherche input {
    width: 100%;
    height: 52px;
    padding: 0 14px 0 44px;
    border: 1px solid var(--trait-2);
    border-radius: 999px;
    background: var(--carte);
    font-size: 1rem;
    outline: none;
  }

  .recherche input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .recherche input::placeholder {
    color: var(--encre-3);
  }

  #ouvrir-filtres {
    flex: none;
    min-height: 52px;
  }

  .nb-filtres:not(:empty) {
    min-width: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--sur-accent);
    font-size: 0.875rem;
    line-height: 20px;
    text-align: center;
  }

  /* ---------- la liste ---------- */

  .liste-tete {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin-top: 18px;
  }

  .retour-sommaire {
    flex-basis: 100%;
    max-width: max-content;
    margin-bottom: 8px;
    padding-left: 12px;
  }

  .titre-liste {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }

  .etat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin: 12px 0 14px;
  }

  .etat:has(.actifs:empty):has(.partager-selection[hidden]) {
    display: none;
  }

  .nb-resultats {
    color: var(--encre-2);
  }

  .nb-resultats strong {
    color: var(--encre);
    font-variant-numeric: tabular-nums;
  }

  .partager-selection {
    margin-left: auto;
  }

  .actifs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .actifs :global(button) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px 0 16px;
    border: 0;
    border-radius: 999px;
    background: var(--accent-doux);
    color: var(--accent-fort);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .actifs :global(svg) {
    width: 16px;
    height: 16px;
  }

  .vide {
    padding: 64px 0;
    text-align: center;
    color: var(--encre-2);
  }

  .vide-titre {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--encre);
  }

  .vide .bouton {
    margin-top: 18px;
  }

  /* ---------- panneau des filtres ---------- */

  .panneau {
    width: min(460px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    background: var(--fond);
    color: var(--encre);
    box-shadow: var(--ombre-forte);
  }

  .panneau::backdrop {
    background: rgb(30 20 10 / 35%);
    backdrop-filter: blur(2px);
  }

  .panneau[open] {
    animation: glisse 0.22s ease-out;
  }

  @keyframes glisse {
    from {
      transform: translateX(30px);
      opacity: 0;
    }
  }

  @media (max-width: 560px) {
    /* sur téléphone, le panneau monte du bas, juste à la hauteur des filtres */
    .panneau {
      inset: auto 0 0;
      width: 100vw;
      height: auto;
      max-height: 88dvh;
      margin: 0;
      border-radius: 20px 20px 0 0;
    }
    .panneau[open] {
      animation-name: monte;
    }
    @keyframes monte {
      from {
        transform: translateY(40px);
        opacity: 0;
      }
    }
  }

  .panneau-contenu {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .panneau-tete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--trait);
  }

  .panneau-tete h2 {
    font-size: 1.5rem;
  }

  .panneau-corps {
    flex: 1;
    overflow-y: auto;
    padding: 8px 20px 24px;
  }

  .panneau fieldset {
    margin: 0;
    padding: 18px 0 4px;
    border: 0;
  }

  .panneau legend {
    padding: 0;
    margin-bottom: 10px;
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .puces {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .puces .puce :global(svg) {
    width: 16px;
    height: 16px;
  }

  .puces .puce[disabled] {
    opacity: 0.4;
    cursor: default;
  }

  .panneau-pied {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 20px calc(14px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--trait);
  }

  .panneau-pied .bouton-principal {
    flex: 1;
    justify-content: center;
  }
</style>

<script>
  import { initialiserCarnet } from '../scripts/carnet';
  import { initialiserFrigo } from '../scripts/frigo';
  import { lireCuisinees } from '../scripts/perso';

  const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
  initialiserFrigo(base);
  initialiserCarnet();

  // « déjà cuisinée » sur les fiches
  const majCuites = () => {
    const cuites = lireCuisinees();
    document.querySelectorAll<HTMLElement>('.fiche[data-slug]').forEach((f) => {
      const oui = f.dataset.slug! in cuites;
      const meta = f.querySelector('.fiche-meta');
      const badge = meta?.querySelector('.badge-cuite');
      if (oui && meta && !badge) meta.insertAdjacentHTML('beforeend', '<span class="badge badge-cuite">✓ Cuisinée</span>');
      if (!oui) badge?.remove();
    });
  };
  majCuites();
  window.addEventListener('cuisinees', majCuites);
</script>
